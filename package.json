{
  "name": "devnetra",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev:kids": "pnpm --filter @devnetra/kids-web dev",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "build": "turbo run build",
    "test": "turbo run test",
    "ci:contracts": "node scripts/ci-local.mjs",
    "ci:local": "pnpm ci:contracts && pnpm test:ui-contracts && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:ui-contracts": "node scripts/test-ui-contracts.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "globals": "^16.0.0"
  }
}
