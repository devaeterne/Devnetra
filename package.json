{
  "name": "devnetra",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev:kids": "pnpm --filter @devnetra/kids-web dev",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "build": "turbo run build",
    "test": "turbo run test",
    "ci:contracts": "node scripts/ci-local.mjs",
    "ci:local": "pnpm ci:contracts && pnpm test:ui-contracts && pnpm test:docs-contract && pnpm test:mascot && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:ui-contracts": "node scripts/test-ui-contracts.mjs",
    "test:mascot": "node scripts/test-mascot-asset.mjs",
    "test:visual": "node scripts/test-mimo-browser.mjs",
    "test:ai-robot-editor": "node scripts/test-ai-robot-editor.mjs",
    "test:docs-contract": "node scripts/test-docs-contract.mjs",
    "test:ai-robot-real": "node scripts/test-ai-robot-real-browser.mjs",
    "test:mascot-mini-browser": "node scripts/test-mascot-mini-challenge-browser.mjs",
    "test:mascot-fallback-browser": "node scripts/test-ai-robot-fallback-browser.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "playwright": "^1.65.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
